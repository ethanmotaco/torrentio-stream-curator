# Server port. Default: 7000.
PORT=7000

# Counter namespace for abacus.jasoncameron.dev. Change this when forking so your
# install + pick counts don't mix with the public deploy.
# COUNTER_NAMESPACE=my-fork-namespace-9f3a

# Override the auto-detected public origin used in manifest URLs (logo, background).
# Required on hosts that rewrite the Host header to an internal container slug
# (e.g. Beamup). No trailing slash. Example:
# PUBLIC_URL=https://your-addon.example.com
