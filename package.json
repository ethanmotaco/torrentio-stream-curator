{
  "name": "torrentio-stream-curator",
  "version": "1.0.0",
  "private": true,
  "description": "Stremio addon that curates Torrentio + Real Debrid streams.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "heroku-postbuild": "npm run build"
  },
  "keywords": [
    "stremio",
    "stremio-addon",
    "torrentio",
    "real-debrid",
    "streaming",
    "typescript",
    "express"
  ],
  "author": "Ethan Motaco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethanmotaco/torrentio-stream-curator.git"
  },
  "homepage": "https://github.com/ethanmotaco/torrentio-stream-curator#readme",
  "bugs": {
    "url": "https://github.com/ethanmotaco/torrentio-stream-curator/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "express": "^4.21.2",
    "lru-cache": "^11.0.2",
    "parse-torrent-title": "^3.0.1",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
